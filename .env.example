# Google Cloud Vision API Key
# https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# SHA-1 fingerprint of the Android signing cert (no colons, uppercase hex).
# Required so API key restrictions accept requests from plain fetch.
# Get via: eas credentials -> Android -> preview -> Keystore -> SHA-1 Fingerprint
ANDROID_CERT_SHA1=
